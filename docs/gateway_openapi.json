  "components": {
    "schemas": {
      "ApprovalDecision": {
        "properties": {
          "approve": {
            "type": "boolean",
            "title": "Approve"
          }
        },
        "type": "object",
        "required": [
          "approve"
        ],
        "title": "ApprovalDecision"
      },
      "ApprovalView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "tool_name": {
            "type": "string",
            "title": "Tool Name"
          },
          "risk_level": {
            "type": "string",
            "title": "Risk Level"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided By"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tool_name",
          "risk_level",
          "reason",
          "decision",
          "decided_by"
        ],
        "title": "ApprovalView"
      },
      "ArtifactView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "step_id": {
            "type": "string",
            "title": "Step Id"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "verified": {
            "type": "boolean",
            "title": "Verified"
          },
          "evidence": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evidence"
          }
        },
        "type": "object",
        "required": [
          "id",
          "step_id",
          "path",
          "sha256",
          "size",
          "verified",
          "evidence"
        ],
        "title": "ArtifactView"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "StepView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "input": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input"
          },
          "output": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          },
          "retries": {
            "type": "integer",
            "title": "Retries"
          }
        },
        "type": "object",
        "required": [
          "id",
          "index",
          "title",
          "status",
          "input",
          "output",
          "retries"
        ],
        "title": "StepView"
      },
      "TaskCreate": {
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 1,
            "title": "Goal"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "title": "Path"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "tool_name": {
            "type": "string",
            "enum": [
              "workspace.write_text",
              "sandbox.shell"
            ],
            "title": "Tool Name",
            "default": "workspace.write_text"
          },
          "command": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Command"
          }
        },
        "type": "object",
        "required": [
          "goal",
          "path",
          "content"
        ],
        "title": "TaskCreate"
      },
      "TaskView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "goal": {
            "type": "string",
            "title": "Goal"
          },
          "target_path": {
            "type": "string",
            "title": "Target Path"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "checkpoint": {
            "type": "string",
            "title": "Checkpoint"
          },
          "cancellation_requested": {
            "type": "boolean",
            "title": "Cancellation Requested"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepView"
            },
            "type": "array",
            "title": "Steps"
          },
          "transitions": {
            "items": {
              "$ref": "#/components/schemas/TransitionView"
            },
            "type": "array",
            "title": "Transitions"
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactView"
            },
            "type": "array",
            "title": "Artifacts"
          },
          "approvals": {
            "items": {
              "$ref": "#/components/schemas/ApprovalView"
            },
            "type": "array",
            "title": "Approvals"
          }
        },
        "type": "object",
        "required": [
          "id",
          "goal",
          "target_path",
          "status",
          "revision",
          "checkpoint",
          "cancellation_requested",
          "created_at",
          "updated_at",
          "steps",
          "transitions",
          "artifacts",
          "approvals"
        ],
        "title": "TaskView"
      },
      "TransitionView": {
        "properties": {
          "entity_id": {
            "type": "string",
            "title": "Entity Id"
          },
          "entity_type": {
            "type": "string",
            "title": "Entity Type"
          },
          "from_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "From State"
          },
          "to_state": {
            "type": "string",
            "title": "To State"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "correlation_id": {
            "type": "string",
            "title": "Correlation Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "entity_id",
          "entity_type",
          "from_state",
          "to_state",
          "reason",
          "actor",
          "correlation_id",
          "created_at"
        ],
        "title": "TransitionView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}