{
  "name": "antigona-frontend-example",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal TypeScript + Vite example frontend (allowlisted frontend_build target for Antigona).",
  "engines": { "node": ">=20" },
  "packageManager": "npm@10.9.8",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "dev": "vite"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
